#!/usr/bin/env python3

import argparse
import logging
import os
import pickle
import sys

import numpy as np
import matplotlib.pyplot as plt

import medicc

logger = logging.getLogger('medicc-main')

version_string = f'medicc {medicc.__version__} from {os.path.dirname(medicc.__file__)} ' + \
                 f'(python {sys.version.split(" ")[0]})'

parser = argparse.ArgumentParser()
parser.add_argument("input_file",
                    help="Path to the input file")
parser.add_argument("output_dir",
                    help="Path to the output folder")
parser.add_argument('--version', action='version', version=version_string)
parser.add_argument("--input-type", "-i", type=str, dest="input_type", default="t",
                    choices=["f", "t", "fasta", "tsv"], required=False,
                    help="Choose the type of input: f for FASTA, t for TSV (default: TSV)")
parser.add_argument("--input-allele-columns", "-a",
                    type=str,
                    dest='input_allele_columns',
                    default='cn_a, cn_b',
                    required=False,
                    help="""Name of the CN columns (comma separated) if using TSV input format (default: 'cn_a, cn_b').
                    This also adjusts the number of alleles considered (min. 1, max. 2).""")
parser.add_argument("--input-chr-separator",
                    type=str,
                    dest='input_chr_separator',
                    default='X',
                    required=False,
                    help='Character used to separate chromosomes in the input data (condensed FASTA only, default: \"X\").')
parser.add_argument("--tree",
                    action="store",
                    dest="user_tree",
                    help="Do not reconstruct a tree, use the provided tree instead (in newick format) and only perform ancestral reconstruction (default: None).",
                    required=False)
parser.add_argument("--topology-only", "-s",
                    action="store_true",
                    dest="topology_only",
                    help="Output only tree topology, without reconstructing ancestors (default: False).",
                    required=False)
parser.add_argument("--length-aware-ancestors", "-la",
                    action="store_true",
                    dest="length_aware_ancestors",
                    default=False,
                    help="Use the matched event-counting FST for the upper pass and length-encoding FST for lower-pass ancestral selection. MEDICC distance matrix and reported branch lengths remain event-counted.")
parser.add_argument("--nni-mode", action="store_true", default=False, dest='nni_mode',
                    help="Launch Nearest Neighbor Interchange (NNI) topology search.")
parser.add_argument("--nni-max-topology", type=int, default=20000, dest='nni_max_iter', help="Hard cap on the total number of NNI neighbor evaluations across all sweeps.")
parser.add_argument("--nni-export-all-topology", action="store_true", default=False, dest='nni_export_all_topology',
                    help="Export all co-optimal topologies that NNI found.")
parser.add_argument("--nni-complete-log", action="store_true", default=False, dest='nni_complete_log',
                    help="Write a complete per-sweep trace of NNI mode (topology and score at every step) to <output_dir>/nni-trace/.")
parser.add_argument("--normal-name", "-n",
                    default="diploid",
                    type=str,
                    dest="normal_name",
                    help="""ID of the sample to be treated as the normal sample. 
                    Trees are rooted at this sample for ancestral reconstruction (default: \"diploid\").
                    If the sample ID is not found, an artificial normal sample of the same name is created 
                    with CN states = 1 for each allele.""",
                    required=False)
parser.add_argument("--exclude-samples", "-x",
                    default=None,
                    type=str,
                    help="Comma separated list of sample IDs to exclude.",
                    required=False)
parser.add_argument("--filter-segment-length",
                    type=str,
                    dest='filter_segment_length',
                    default=None,
                    required=False,
                    help="Removes segments that are smaller than the specified length.")
parser.add_argument("--bootstrap-method",
                    type=str,
                    dest='bootstrap_method',
                    default='chr-wise',
                    required=False,
                    help="Bootstrap method: either 'chr-wise' or 'segment-wise'.")
parser.add_argument("--bootstrap-nr",
                    type=int,
                    dest='bootstrap_nr',
                    default=None,
                    required=False,
                    help="Number of bootstrap runs to perform (minimum 5).")
parser.add_argument("--prefix", '-p', type=str, dest='prefix', default=None,
                    help='Output prefix to be used (default: input filename).', required=False)
parser.add_argument("--no-wgd", action='store_true', default=False, dest='no_wgd',
                    help='Disable whole-genome doubling events (default: False, WGD is considered by default).', required=False)
parser.add_argument('--plot',
                    type=str,
                    default='auto',
                    required=False,
                    choices=["auto", "bars", "heatmap", "both", "none"],
                    help="""Type of copy-number plot to save. 'bars' is recommended for <50 samples, 
                         'heatmap' for more samples, 'auto' will decide based on the number of samples, 
                         'both' will plot both and 'none' will plot neither. (default: auto).""")
parser.add_argument("--no-plot-tree", action='store_true', default=False, dest='no_plot_tree',
                    help='Disable plotting of tree (default: False).', required=False)
parser.add_argument("--total-copy-numbers",
                    dest="total_copy_numbers",
                    action='store_true',
                    default=False,
                    required=False,
                    help='Run for total copy number data instead of allele-specific data (default: False).')
parser.add_argument("-j", "--n-cores",
                    type=int,
                    dest='n_cores',
                    default=None,
                    required=False,
                    help="Number of cores to run on.")
parser.add_argument("--events", action='store_true', default=False, dest='events',
                    help='Whether to infer copy-number events (default: False).', required=False)
parser.add_argument("--chromosomes-bed",
                    type=str,
                    dest='chromosomes_bed',
                    default='none',
                    required=False,
                    help="BED file for chromosome regions.")
parser.add_argument("--regions-bed",
                    type=str,
                    dest='regions_bed',
                    default='none',
                    required=False,
                    help="BED file for regions of interests.")
parser.add_argument("-v", "--verbose", action='store_true', default=False,
                    help='Enable verbose output (default: False).', required=False)
parser.add_argument("-vv", "--debug", action='store_true', default=False,
                    help='Enable more verbose output (default: False).', required=False)
parser.add_argument("--silent", action='store_true', default=False,
                    help='Hide all output (default: False).', required=False)
parser.add_argument("--maxcn", type=int, dest='maxcn', default=8,
                    help='''Expert option: maximum CN at which the input is capped. Does not change FST.
                            The maximum possible value is 8 (default: 8)''')
parser.add_argument("--prune-weight", type=int, dest='prune_weight', default=0,
                    help='''Expert option: Prune weight in ancestor reconstruction. Values >0 might
                            result in more accurate ancestors but will require more time and memory (default: 0)''')
parser.add_argument("--fst", type=str, dest='fst', default=None,
                    help='Expert option: path to an alternative FST. Deprecated, to keep the same behavior, replace \'--fst File\' with \'--upper-fst File --lower-fst File\'')
parser.add_argument("--upper-fst", type=str, dest='upper_fst', default=None,
                    help='Expert option: path to an alternative upper FST.')
parser.add_argument("--lower-fst", type=str, dest='lower_fst', default=None,
                    help='Expert option: path to an alternative lower FST.')
parser.add_argument("--fst-chr-separator", type=str, dest='fst_chr_separator', default='X',
                    help = 'Expert option: character used to separate chromosomes in the FST (default: \"X\").')
parser.add_argument("--wgd-x2", action='store_true', default=False, dest='wgd_x2',
                    help='Expert option: treat WGD as an x2 operation (default: False).', required=False)
args = parser.parse_args()


if args.verbose:
    logging.getLogger('medicc').setLevel(logging.INFO)
if args.debug:
    logging.getLogger('medicc').setLevel(logging.DEBUG)
if args.silent:
    logging.getLogger('medicc').setLevel(logging.CRITICAL)
    logger.setLevel(logging.CRITICAL)

# Handle impossible combinations of command line flags
if args.bootstrap_nr is not None and (args.bootstrap_nr < 5):
    raise ValueError('bootstrap_nr must be at least 5.')
if args.nni_mode:
    if args.topology_only:
        raise ValueError("NNI mode requires ancestral reconstruction, so --topology-only cannot be used together with --nni-mode.")
    if args.nni_export_all_topology and args.bootstrap_nr is not None:
        raise ValueError("--nni-export-all-topology cannot be combined with --bootstrap-nr / --bootstrap-method: bootstrapping requires a single reference tree.")
else:
    if args.nni_export_all_topology or args.nni_complete_log:
        raise ValueError("--nni-export-all-topology and --nni-complete-log are only valid when --nni-mode is enabled.")

output_dir = args.output_dir
if args.nni_complete_log:
    nni_trace_dir = os.path.join(output_dir, 'nni-trace')
else:
    nni_trace_dir = None

normal_name = args.normal_name 
allele_columns = [x.strip() for x in args.input_allele_columns.split(',')]

if not os.path.exists(output_dir):
    os.makedirs(output_dir)

# Determine prefix for output files 
if args.prefix is None:
    output_prefix = os.path.basename(os.path.splitext(args.input_file)[0])
else:
    output_prefix = args.prefix

# Read in symbol table and transducers
logger.info("Reading FST.")
# FST logic handling
has_upper_fst = args.upper_fst is not None
has_lower_fst = args.lower_fst is not None

if has_upper_fst != has_lower_fst:
    parser.error("--upper-fst and --lower-fst must be specified together.")

has_custom_pair = has_upper_fst and has_lower_fst

selected_fst_modes = sum([
    args.fst is not None,
    has_custom_pair,
    args.length_aware_ancestors,
])

if selected_fst_modes > 1:
    parser.error("--fst, the --upper-fst/--lower-fst pair and "
                 "--length-aware-ancestors are mutually exclusive.")

if args.fst is not None:
    logging.warning("--fst is deprecated; to keep the same behavior, use --upper-fst File --lower-fst File instead.")
    upper_fst_path = args.fst
    upper_pass_fst = medicc.io.read_fst(user_fst=upper_fst_path,
                                        no_wgd=args.no_wgd,
                                        total_copy_numbers=args.total_copy_numbers,
                                        wgd_x2=args.wgd_x2,
                                        length_encoding=False)
    lower_pass_fst = upper_pass_fst
elif has_custom_pair:
    upper_fst_path = args.upper_fst
    lower_fst_path = args.lower_fst
    upper_pass_fst = medicc.io.read_fst(user_fst=upper_fst_path,
                                        no_wgd=args.no_wgd,
                                        total_copy_numbers=args.total_copy_numbers,
                                        wgd_x2=args.wgd_x2,
                                        length_encoding=False)
    lower_pass_fst = medicc.io.read_fst(user_fst=lower_fst_path,
                                        no_wgd=args.no_wgd,
                                        total_copy_numbers=args.total_copy_numbers,
                                        wgd_x2=args.wgd_x2,
                                        length_encoding=True)
elif args.length_aware_ancestors:
    upper_fst_path = None
    lower_fst_path = None
    upper_pass_fst = medicc.io.read_fst(user_fst=upper_fst_path,
                                        no_wgd=args.no_wgd,
                                        total_copy_numbers=args.total_copy_numbers,
                                        wgd_x2=args.wgd_x2,
                                        length_encoding=False)
    lower_pass_fst = medicc.io.read_fst(user_fst=lower_fst_path,
                                        no_wgd=args.no_wgd,
                                        total_copy_numbers=args.total_copy_numbers,
                                        wgd_x2=args.wgd_x2,
                                        length_encoding=True)
else:
    upper_fst_path = None
    lower_fst_path = None
    upper_pass_fst = medicc.io.read_fst(user_fst=upper_fst_path,
                                        no_wgd=args.no_wgd,
                                        total_copy_numbers=args.total_copy_numbers,
                                        wgd_x2=args.wgd_x2,
                                        length_encoding=False)
    lower_pass_fst = upper_pass_fst


if args.user_tree is not None:
    logger.info("Importing user tree.")
    input_tree = medicc.io.import_tree(tree_file=args.user_tree, normal_name=normal_name)
else:
    input_tree = None

# Load data
logger.info("Reading and parsing input data.")
input_df = medicc.io.read_and_parse_input_data(
    filename=args.input_file,
    normal_name=normal_name,
    input_type=args.input_type.strip(),
    separator=args.input_chr_separator.strip(),
    allele_columns=allele_columns,
    total_copy_numbers=args.total_copy_numbers,
    maxcn=args.maxcn)

if args.filter_segment_length is not None:
    old_size = len(input_df)
    input_df = medicc.io.filter_by_segment_length(input_df, args.filter_segment_length)
    logger.info("Removed input segments smaller than {}bp. Old size: {} -> new size: {}".format(
        int(float(args.filter_segment_length)),
        old_size, 
        len(input_df)))

if args.exclude_samples is not None:
    exclude_samples = np.array([x.strip() for x in args.exclude_samples.split(',')])
    logger.info(f"Excluding samples {', '.join(exclude_samples)}.")
    input_df = input_df.loc[~np.isin(input_df.index.get_level_values('sample_id'), exclude_samples), :]

if args.n_cores is not None:
    logger.info("Running on {} cores.".format(args.n_cores))

# Run main method
logger.info("Running main reconstruction routine.")
if not args.nni_mode:
    sample_labels, pairwise_distances, nj_tree, final_tree, output_df, events_df = medicc.main(
        input_df=input_df,
        asymm_upper_fst=upper_pass_fst,
        asymm_lower_fst=lower_pass_fst,
        normal_name=normal_name,
        input_tree=input_tree,
        ancestral_reconstruction=not args.topology_only,
        chr_separator=args.fst_chr_separator.strip(),
        prune_weight=args.prune_weight,
        allele_columns=allele_columns,
        no_wgd=args.no_wgd,
        wgd_x2=args.wgd_x2,
        total_cn=args.total_copy_numbers,
        n_cores=args.n_cores,
        reconstruct_events=args.events,
        nni_mode_flag=False)
else:
    if not args.nni_export_all_topology:
        sample_labels, pairwise_distances, nj_tree, final_tree, output_df, events_df, nni_trace, nni_step_records = medicc.main(
            input_df=input_df,
            asymm_upper_fst=upper_pass_fst,
            asymm_lower_fst=lower_pass_fst,
            normal_name=normal_name,
            input_tree=input_tree,
            ancestral_reconstruction=not args.topology_only,
            chr_separator=args.fst_chr_separator.strip(),
            prune_weight=args.prune_weight,
            allele_columns=allele_columns,
            no_wgd=args.no_wgd,
            wgd_x2=args.wgd_x2,
            total_cn=args.total_copy_numbers,
            n_cores=args.n_cores,
            reconstruct_events=args.events,
            nni_mode_flag=True,
            nni_max_iter=args.nni_max_iter,
            nni_trace_dir=nni_trace_dir,
            nni_export_all_topology=False)
    else:
        sample_labels, pairwise_distances, nj_tree, final_tree_l, output_df_l, events_df_l, nni_trace, nni_step_records = medicc.main(
            input_df=input_df,
            asymm_upper_fst=upper_pass_fst,
            asymm_lower_fst=lower_pass_fst,
            normal_name=normal_name,
            input_tree=input_tree,
            ancestral_reconstruction=not args.topology_only,
            chr_separator=args.fst_chr_separator.strip(),
            prune_weight=args.prune_weight,
            allele_columns=allele_columns,
            no_wgd=args.no_wgd,
            wgd_x2=args.wgd_x2,
            total_cn=args.total_copy_numbers,
            n_cores=args.n_cores,
            reconstruct_events=args.events,
            nni_mode_flag=True,
            nni_max_iter=args.nni_max_iter,
            nni_trace_dir=nni_trace_dir,
            nni_export_all_topology=True)

        # Handle all topology file io
        # Write results
        topology_counter = 1
        for i in range(len(final_tree_l)):
            final_tree = final_tree_l[i]
            topology_counter = i + 1
            output_df = output_df_l[i]
            events_df = events_df_l[i] if events_df_l is not None else None

            # Create a directory under output_dir for this topology
            topology_dir = os.path.join(output_dir, f"topology_{topology_counter}")
            os.makedirs(topology_dir, exist_ok=True)

            # Write trees
            logger.info(f"Writing tree for topology {topology_counter}.")
            medicc.io.write_tree_files(tree=final_tree, normal_name=normal_name, out_name=os.path.join(
                topology_dir, output_prefix + f"_final_tree_topology_{topology_counter}"),
                                       plot_tree=(not args.no_plot_tree))
            medicc.io.write_branch_lengths(tree=final_tree, out_name=os.path.join(
                topology_dir, output_prefix + f"_branch_lengths_topology_{topology_counter}.tsv"))

            # Write output table
            output_df.to_csv(
                os.path.join(topology_dir, output_prefix + f"_final_cn_profiles_topology_{topology_counter}.tsv"),
                sep='\t')

            # Write events
            if events_df is not None:
                events_df.to_csv(os.path.join(topology_dir, output_prefix + "_copynumber_events_df.tsv"),
                                 sep='\t', index=True)

                if args.chromosomes_bed != 'none' or args.regions_bed != 'none':
                    logger.info("Overlapping copy-number events with chromosomes and known oncogenes.")
                    overlaps = medicc.event_reconstruction.overlap_events(events_df=events_df, alleles=allele_columns,
                                                                          normal_name=normal_name,
                                                                          chromosome_bed=args.chromosomes_bed,
                                                                          regions_bed=args.regions_bed)
                    overlaps.to_csv(os.path.join(topology_dir, output_prefix + "_events_overlap.tsv"),
                                    sep='\t', index=True)

            # Summarize
            logger.info("Writing patient summary.")
            summary = medicc.summarize_patient(
                final_tree, pairwise_distances.values, sample_labels, normal_name, events_df)
            summary.to_csv(os.path.join(topology_dir, output_prefix + "_summary.tsv"),
                           index=True, header=False, sep='\t')

            # Plotting
            if args.plot == 'both':
                plotting = ['heatmap', 'bars']
            elif args.plot == 'auto':
                if len(sample_labels) < 50:
                    plotting = ['bars']
                else:
                    plotting = ['heatmap']
            else:
                plotting = [args.plot]

            if 'bars' in plotting:
                logger.info(f"Plotting copy-number profiles (bars) for topology {topology_counter}.")
                p = medicc.plot.plot_cn_profiles(
                    output_df,
                    input_tree=final_tree,
                    title=output_prefix,
                    normal_name=normal_name,
                    allele_columns=allele_columns,
                    show_branch_support=False,
                    label_func=None)
                p.savefig(os.path.join(topology_dir, output_prefix + f'_cn_profiles_topology_{topology_counter}.pdf'),
                          bbox_inches='tight')
                plt.close(p)

            if 'heatmap' in plotting:
                logger.info(f"Plotting copy-number profiles (heatmap) for topology {topology_counter}.")
                p = medicc.plot.plot_cn_heatmap(
                    output_df,
                    final_tree=final_tree,
                    alleles=allele_columns, normal_name=normal_name,
                    total_copy_numbers=args.total_copy_numbers)
                p.savefig(
                    os.path.join(topology_dir, output_prefix + f'_cn_profiles_heatmap_topology_{topology_counter}.pdf'),
                    bbox_inches='tight')
                plt.close(p)

            if 'none' in plotting:
                logger.info(
                    f"Skipped plotting of copy-number profiles (change --plot if this is undesired) for topology {topology_counter}.")


    # Write NNI log and plot nni_trace
    fig = medicc.plot.plot_nni_trace(nni_trace)
    fig.savefig(
        os.path.join(output_dir, "nni_trace.png"), bbox_inches='tight'
    )
    plt.close(fig)
    if nni_trace_dir is not None and nni_step_records:
        logger.info("NNI mode: Writing trace file to %s", nni_trace_dir)
        os.makedirs(nni_trace_dir, exist_ok=True)
        # Write one single tsv file for the trace
        tsv_path = os.path.join(nni_trace_dir, "nni_trace.tsv")
        with open(tsv_path, "w") as tsv:
            tsv.write("step\tnewick\tsum_of_branch_length\n")
            for step, newick_str, score in sorted(nni_step_records):
                tsv.write(f"{step}\t{newick_str}\t{score}\n")



# Output pairwise distance matrices
logger.info("Writing pairwise distance matrices.")
medicc.io.write_pairwise_distances(sample_labels, pairwise_distances, os.path.join(
    output_dir, output_prefix + "_pairwise_distances"))

if args.nni_export_all_topology:
    logger.info("MEDICC2 has finished.")
    sys.exit(0)

# Write events table and overlap events with chromosome and oncogenes
if events_df is not None:
    events_df.to_csv(os.path.join(output_dir, output_prefix + "_copynumber_events_df.tsv"),
                     sep='\t', index=True)

    if args.chromosomes_bed != 'none' or args.regions_bed != 'none':
        logger.info("Overlapping copy-number events with chromosomes and known oncogenes.")
        overlaps = medicc.event_reconstruction.overlap_events(events_df=events_df, alleles=allele_columns,
                                            normal_name=normal_name,
                                            chromosome_bed=args.chromosomes_bed,
                                            regions_bed=args.regions_bed)
        overlaps.to_csv(os.path.join(output_dir, output_prefix + "_events_overlap.tsv"),
                        sep='\t', index=True)

logger.info(f"Output is saved as {output_dir}/{output_prefix}...")

# Write trees
logger.info("Writing trees.")
# medicc.io.write_tree_files(tree=nj_tree, out_name=os.path.join(
#     output_dir, output_prefix + "_nj_tree"))
medicc.io.write_tree_files(tree=final_tree, normal_name=normal_name, out_name=os.path.join(
    output_dir, output_prefix + "_final_tree"), plot_tree=(not args.no_plot_tree))
medicc.io.write_branch_lengths(tree=final_tree, out_name=os.path.join(
    output_dir, output_prefix + "_branch_lengths.tsv"))

# Write output table
if not args.topology_only:
    output_df.to_csv(os.path.join(output_dir, output_prefix + "_final_cn_profiles.tsv"), sep='\t')

# Summarize
logger.info("Writing patient summary.")
summary = medicc.summarize_patient(
    final_tree, pairwise_distances.values, sample_labels, normal_name, events_df)
logger.info(f"Final tree length (sum of branch length): {summary.tree_length}.")
summary.to_csv(os.path.join(output_dir, output_prefix + "_summary.tsv"),
               index=True, header=False, sep='\t')

# Bootstrap
if args.bootstrap_nr is not None:
    logger.info("Performing {} bootstrap runs (method: {})".format(args.bootstrap_nr, 
                                                                   args.bootstrap_method))
    bootstrap_trees_df, support_tree = medicc.bootstrap.run_bootstrap(input_df=input_df,
                                                                      original_tree=final_tree,
                                                                      N_bootstrap=args.bootstrap_nr, 
                                                                      method=args.bootstrap_method,
                                                                      normal_name=normal_name,
                                                                      n_cores=args.n_cores)

    logger.info('Writing bootstrap output.')
    with open(os.path.join(output_dir, output_prefix + "_bootstrap_trees_df.pickle"), 'wb') as f:
        pickle.dump(bootstrap_trees_df, f)

    medicc.io.write_tree_files(tree=support_tree, out_name=os.path.join(
        output_dir, output_prefix + "_support_tree"), plot_tree=False, draw_ascii=False)
    fig = medicc.plot.plot_tree(support_tree,
                                title='support tree',
                                normal_name=normal_name,
                                show_branch_lengths=True,
                                show_branch_support=True)
    fig.savefig(os.path.join(output_dir, output_prefix + '_support_tree.pdf'), bbox_inches='tight')
    plt.close(fig)
else:
    support_tree = None

# Plot copy-number tracks
if args.plot == 'both':
    plotting = ['heatmap', 'bars']
elif args.plot == 'auto':
    if len(sample_labels) < 50:
        plotting = ['bars']
    else:
        plotting = ['heatmap']
else:
    plotting = [args.plot]

if 'bars' in plotting:
    logger.info("Plotting copy-number profiles (bars).")
    if args.topology_only:
        raise ValueError('Cannot plot "bars" when --topology-only is set. Please change --plot option to "heatmap" or "none".')
    p = medicc.plot.plot_cn_profiles(
        output_df, 
        input_tree=support_tree if support_tree is not None else final_tree,
        title=output_prefix, 
        normal_name=normal_name,
        allele_columns=allele_columns,
        show_branch_support=support_tree is not None,
        label_func=None)
    p.savefig(os.path.join(output_dir, output_prefix + '_cn_profiles.pdf'), bbox_inches='tight')
    plt.close(p)

if 'heatmap' in plotting:
    logger.info("Plotting copy-number profiles (heatmap).")
    p = medicc.plot.plot_cn_heatmap(
        output_df, 
        final_tree=support_tree if support_tree is not None else final_tree,
        alleles=allele_columns, normal_name=normal_name,
        total_copy_numbers=args.total_copy_numbers)
    p.savefig(os.path.join(output_dir, output_prefix + '_cn_profiles_heatmap.pdf'), bbox_inches='tight')
    plt.close(p)

if 'none' in plotting:
    logger.info("Skipped plotting of copy-number profiles (change --plot if this is undesired).")

logger.info("MEDICC2 has finished.")
